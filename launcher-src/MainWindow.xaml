<Window x:Class="ForgeNeoLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Forge Neo 启动器"
        Icon="icon/face_adaptive.ico"
        Height="720" Width="1180"
        Background="{DynamicResource WindowBg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="620" MinWidth="980">

    <!-- 自绘标题栏：保留系统贴边吸附 / 双击最大化 / 拖拽，仅把外观交给 WPF -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ============ 主题资源（运行时用代码切换，DynamicResource 才生效） ============ -->
        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7F8FA" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="0.5"/>
            <GradientStop Color="#EEF1F5" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5D9CF5" Offset="0"/>
            <GradientStop Color="#7C66F0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGreen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3AB77C" Offset="0"/>
            <GradientStop Color="#2E9E68" Offset="1"/>
        </LinearGradientBrush>

        <!-- 侧边栏 -->
        <SolidColorBrush x:Key="SidebarBg" Color="#EEF1F5"/>
        <SolidColorBrush x:Key="SidebarBorder" Color="#E1E6EC"/>
        <SolidColorBrush x:Key="SubtitleText" Color="#8A93A0"/>
        <SolidColorBrush x:Key="MenuIdleFore" Color="#5B6472"/>
        <SolidColorBrush x:Key="MenuBtnHover" Color="#E7EBF0"/>

        <!-- 顶部工具栏 -->
        <SolidColorBrush x:Key="TopBarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TopBarBorder" Color="#E1E6EC"/>
        <SolidColorBrush x:Key="TopBtnBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TopBtnText" Color="#3A4452"/>
        <SolidColorBrush x:Key="TopBtnBorder" Color="#DFE4EA"/>
        <SolidColorBrush x:Key="TopBtnHover" Color="#E9EEF4"/>
        <SolidColorBrush x:Key="StateText" Color="#2E343E"/>
        <SolidColorBrush x:Key="StateDetail" Color="#7A8492"/>
        <SolidColorBrush x:Key="StateDotRing" Color="#FFFFFF"/>

        <!-- 进度栏 -->
        <SolidColorBrush x:Key="ProgressBack" Color="#EAEEF3"/>
        <SolidColorBrush x:Key="ProgressText" Color="#3A4452"/>
        <SolidColorBrush x:Key="ProgressDetail" Color="#7A8492"/>

        <!-- 状态灯空闲色 -->
        <SolidColorBrush x:Key="StatusDotIdle" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="StatusTextIdle" Color="#6B7280"/>

        <!-- ============ 自绘标题栏 ============ -->
        <SolidColorBrush x:Key="TitleBarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TitleBarBorder" Color="#E1E6EC"/>
        <SolidColorBrush x:Key="TitleBarText" Color="#2E343E"/>
        <SolidColorBrush x:Key="CaptionBtnHover" Color="#E9EEF4"/>
        <SolidColorBrush x:Key="CaptionBtnPress" Color="#DCE3EB"/>
        <SolidColorBrush x:Key="CaptionCloseHover" Color="#E24B4A"/>

        <!-- 高级选项：开关 -->
        <SolidColorBrush x:Key="SwitchOffBg" Color="#DDE3EA"/>
        <SolidColorBrush x:Key="SwitchKnob" Color="#FFFFFF"/>

        <!-- 窗口按钮（最小化 / 最大化 / 关闭）—— 绘世风格：无边框、hover 变色、关闭键红色 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarText}"/>
            <!-- 附加属性必须带命名空间前缀，否则解析失败 -->
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionBtnPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭键：hover 红底白字 -->
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 不设 TargetName = 作用于模板父级（Button 本身），
                                 这样 Path 的 {Binding Foreground} 才会跟着变白 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionCloseHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource CaptionCloseHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuIdleFore}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Margin="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TopBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource TopBtnBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TopBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopBtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 首页 · 文件夹快捷卡片（仿绘世：整卡可点、hover 变色、右侧一个箭头） -->
        <Style x:Key="HomeCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,10,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本管理列表：跟随主题的列表项样式 -->
        <Style x:Key="VerListItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource StateDetail}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource ListHeaderBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 高级选项：选项卡 ============ -->
        <!-- 用 RadioButton 而非 Button：选中态由 WPF 自己管，不必在代码里手工维护高亮 -->
        <Style x:Key="AdvTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MenuIdleFore}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="16,8" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <!-- 不写 TargetName = 作用于 RadioButton 自身，文字才跟着变白 -->
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关：胶囊轨道 + 滑块 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track" CornerRadius="11"
                                    Background="{DynamicResource SwitchOffBg}"
                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="16" Height="16"
                                     Fill="{DynamicResource SwitchKnob}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单行输入框（圆角，跟随主题） -->
        <Style x:Key="AdvInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 选项标题 / 说明文字 -->
        <Style x:Key="AdvLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="AdvHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StateDetail}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 目录列表项 -->
        <Style x:Key="AdvListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ PyTorch 环境：下拉框（ComfyUI Desktop 风格，点一下展开菜单） ============
             收起时只显示一行摘要（SelectText），展开的菜单里才显示完整信息。
             这样既没有滚动条堆叠，又能一眼看清当前选的是什么。 -->
        <Style x:Key="ComfyCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TopBtnText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 文字由上层 ContentSite 负责绘制（这样展开动画不会盖住摘要）；
                                                     这里只放右侧的展开箭头 -->
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource StateDetail}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 收起时：只显示一行摘要，不套用下拉项的丰富模板
                                 （ContentPresenter 用了 ContentTemplate 后，模板内 DataContext 即 Content 本身） -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectedItem}"
                                              Margin="14,0,34,0" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SelectText}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TopBtnText}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>

                            <!-- 展开的列表 -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="0,4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <!-- 菜单较高时给个上限，超出才滚动；平时不出现滚动条 -->
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项：主标题 + 次行描述，选中项带勾 -->
        <Style x:Key="ComfyComboItem" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="4,2" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"/>
                                <!-- 选中打勾，和 ComfyUI Desktop 一致 -->
                                <TextBlock x:Name="tick" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="10,0,2,0"
                                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuBtnHover}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 窗口外框：一圈描边 + 圆角。
         为什么需要它：无边框窗口（WindowChrome 吃掉了系统边框）在浅色桌面上**没有轮廓**，
         窗口会和背景糊成一片。1px 描边是最省、最稳的解法（200% 缩放下显示为 2 物理px，够看清）。
         圆角分两层：这里画的圆角负责**描边的形状**，窗口四角的实际裁切由 DWM 负责
         （不透明窗口里 WPF 画的圆角会被窗口的矩形背景盖住，所以必须向 DWM 申请，见 ApplyWindowCorner）。
         SizeChanged 里同步 Clip，否则子元素（标题栏 / 横幅）的直角会反过来盖住这个圆角。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdge}"
            BorderThickness="1"
            CornerRadius="8"
            SizeChanged="RootBorder_SizeChanged">
      <DockPanel>
        <!-- ============ 自绘标题栏（跟随主题色） ============ -->
        <Border DockPanel.Dock="Top" Height="40"
                Background="{DynamicResource TitleBarBg}"
                BorderBrush="{DynamicResource TitleBarBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：程序图标 + 名称（纯展示，不拦截拖拽） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Width="17" Height="17" Stretch="Uniform" Source="icon/logo_face.png"/>
                    <TextBlock Text="Forge Neo 启动器" FontSize="12.5" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TitleBarText}"/>
                    <TextBlock x:Name="TitleVersionText" Text="v0.37" FontSize="11" Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtitleText}"/>
                </StackPanel>

                <!-- 右：窗口按钮（需在 Caption 区域内可点击） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="WinMin_Click" ToolTip="最小化">
                        <!-- 纯水平线用 Rectangle，Path 在零高度下可能不渲染 -->
                        <Rectangle Width="10" Height="1" SnapsToDevicePixels="True"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="WinMaxBtn" Style="{StaticResource CaptionButton}" Click="WinMax_Click" ToolTip="最大化 / 还原">
                        <Path x:Name="MaxIcon"
                              Data="M0,0 H10 V10 H0 Z" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="WinClose_Click" ToolTip="关闭">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区整体（侧栏 + 右侧）。启动时整块从下方浮上来：Win11 设置那种"快速优雅"的入场。
             位移交给 UiFx.PlayEntrance（内部走 BeginAnimation，不用不可控的 Storyboard.Begin()）。
             自绘标题栏**不参与** —— 让它当固定的框架，动的只有内容区。 -->
        <Border x:Name="ContentRoot">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ContentShift" Y="0"/>
            </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧图标菜单栏 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 顶部 logo 区 -->
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,18,0,16">
                        <!-- 圆角已烘入 PNG 的 alpha 通道，无需遮罩 -->
                        <Image Width="38" Height="38" Stretch="Uniform"
                               Source="icon/logo_face.png"/>
                        <TextBlock Text="Forge" Foreground="{DynamicResource SubtitleText}" FontSize="9"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,4,0,0">
                            <TextBlock x:Name="LogoVersionText" Text="v0.37"
                                       Foreground="{DynamicResource SubtitleText}" FontSize="8.5"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- 底部：主题切换按钮（左下角） -->
                    <Button x:Name="ThemeBtn" DockPanel.Dock="Bottom" Style="{StaticResource MenuBtn}"
                            Height="50" Margin="0,0,0,8" Click="Theme_Click">
                        <StackPanel>
                            <TextBlock x:Name="ThemeIcon" Text="☀" FontFamily="Segoe UI Symbol" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ThemeLabel" Text="白天" FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 底部固定：控制台（原先那个占位的「火箭」）—— 状态 / 进度 / 日志都在这儿。
                         放在底部是照绘世的布局：控制台紧邻设置，不跟主要功能抢位置；
                         而且平时不需要主动进来 —— 只要跑起来就会被自动带到这里。 -->
                    <Button x:Name="MenuConsole" DockPanel.Dock="Bottom" Style="{StaticResource MenuBtn}" Tag="控制台"
                            Height="54" Margin="0,0,0,10" Click="Menu_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                            <TextBlock Text="控制台" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 中间菜单 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Top">
                        <!-- 首页：默认落地页。一键启动按钮就在这一页上（不再单独占一个菜单项） -->
                        <Button x:Name="MenuHome" Style="{StaticResource MenuBtn}" Tag="首页" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="首页" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- 一键部署：检测到缺必需文件时自动切到这一页，平时也可手动进来重装 -->
                        <Button x:Name="MenuDeploy" Style="{StaticResource MenuBtn}" Tag="一键部署" Height="54" Click="Menu_Click">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                    <TextBlock Text="一键部署" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- 角标：未部署时亮起，提示这里有事要做（默认隐藏） -->
                                <Ellipse x:Name="DeployDot" Width="8" Height="8" Fill="#E8A22E"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MenuAdvanced" Style="{StaticResource MenuBtn}" Tag="高级选项" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="高级选项" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MenuFix" Style="{StaticResource MenuBtn}" Tag="疑难解答" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="疑难解答" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MenuVersion" Style="{StaticResource MenuBtn}" Tag="版本管理" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="版本管理" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- 插件管理：v0.32 从「版本管理」里拆出来的独立一页。
                             内核只有一个、上游写死；插件有 N 个、各有各的 origin、
                             还要装/卸/启停 —— 硬挤在同一页里，连"一键更新全部"
                             到底更新谁都要靠猜。 -->
                        <Button x:Name="MenuExt" Style="{StaticResource MenuBtn}" Tag="插件管理" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <!-- E74C：拼图块（扩展 / 插件的通行符号）。挑法见 _icon_work/_glyphtest -->
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="插件管理" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MenuModel" Style="{StaticResource MenuBtn}" Tag="模型管理" Height="54" Click="Menu_Click">
                            <StackPanel>
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="模型管理" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- v0.33：删掉「交流群」「设置」两项。
                             它们从未接上任何页面 —— 点下去只在控制台打一行 [占位]，
                             既占侧栏位置、又把侧栏顶出滚动条。要写功能时再加回来，
                             加的时候记住「六处同改」（见 skill §11.1.4）。 -->
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ 右侧内容区 ============ -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <!-- 顶部状态栏这一行用 Auto：首页会把它**整条**收起（见 ShowView）——
                         状态文字、「打开界面」「一键启动」首页底栏那张卡片里都有，
                         维护类动作（生成诊断包 / 终止进程）按本页设计归控制台。
                         写死 64 的话收起后仍会留一条空白，高度交给下面那个 Border 自己带。 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 进度栏这一行同理用 Auto：首页会把它整条收起（进度只在控制台看） -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部状态栏（首页整条收起，让出的 64px 归题图） -->
                <Border x:Name="TopBarRow" Grid.Row="0" Height="64"
                        Background="{DynamicResource TopBarBg}" BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="22,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource StateDotRing}">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#9E9E9E"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StateText" Text="未运行" FontSize="16" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource StateText}"/>
                            <TextBlock x:Name="StateDetail" Text="" FontSize="12" Margin="14,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource StateDetail}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="DiagBtn" Content="生成诊断包" Style="{StaticResource TopBtn}" Height="34" Margin="6,0" Click="Diag_Click"/>
                            <Button x:Name="OpenBtn" Content="打开界面" Style="{StaticResource TopBtn}" Height="34" Margin="6,0" IsEnabled="False" Click="Open_Click"/>
                            <Button x:Name="StopBtn" Content="终止进程" Style="{StaticResource TopBtn}" Height="34" Margin="6,0" IsEnabled="False" Click="Stop_Click"/>
                            <Button x:Name="StartBtn" Content="一键启动" Style="{StaticResource TopBtnPrimary}" Height="34" Margin="6,0" Click="Start_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 进度栏：实时解析日志里的 tqdm 进度。
                     只在非首页显示 —— 控制台已经有同一条进度，首页那份纯属重复，
                     收掉还能把纵向空间让给横幅。 -->
                <Border x:Name="ProgressRow" Grid.Row="1" Height="56"
                        Background="{DynamicResource TopBarBg}" BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <!-- 轨道宽度一变就按比例重画填充（BarTrack_SizeChanged）：这一行右侧的
                                 「已用 4m20s」文字长短会改轨道宽，窗口缩放也会 —— 填充必须拿当下的
                                 轨道宽度现算，只在写文字那一刻算一次就会差一截 -->
                            <Border x:Name="ProgressBack" Background="{DynamicResource ProgressBack}" CornerRadius="9" Height="18"
                                    SizeChanged="BarTrack_SizeChanged"/>
                            <!-- 没有真实百分比时的「在动」指示：色块在轨道里来回滑。
                                 与部署页同一手法（动画走 UiFx，不用不可控的 Storyboard.Begin()）。 -->
                            <Border x:Name="ProgressClip" Background="Transparent" CornerRadius="9" Height="18"
                                    ClipToBounds="True">
                                <Border x:Name="ProgressMarquee" Width="110" HorizontalAlignment="Left" CornerRadius="9"
                                        Background="{StaticResource AccentBrush}" Opacity="0.55"
                                        Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ProgressMarqueeShift" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Border x:Name="ProgressFill" Background="{StaticResource AccentBrush}" CornerRadius="9" Height="18"
                                    HorizontalAlignment="Left" Width="0"/>
                            <TextBlock x:Name="ProgressText" Text="等待任务..."
                                       Foreground="{DynamicResource ProgressText}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="ProgressDetail" Grid.Column="1"
                                   Text="" Foreground="{DynamicResource ProgressDetail}" FontSize="11"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </Border>

                <!-- 中央区域：首页 / 控制台（日志）/ 一键部署 / 版本管理 / 高级选项 可切换 -->
                <Grid Grid.Row="2">

                    <!-- ============ 首页视图（默认落地页，仿绘世） ============ -->
                    <!-- 这一页只做两件事：把人送进某个目录，或把人送进【一键启动】。
                         「正在发生什么」一律只看【控制台】—— 所以启动/维护类动作都会把人带过去。 -->
                    <Border x:Name="HomeView" Background="{DynamicResource WindowBg}" Padding="20,16">
                        <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- 横幅：左文案 + 右人物。压暗层必须留着 ——
                                     banner 是照片，深浅主题下都可能有亮部，白字得靠它压住。
                                     ⚠ 盒高**故意不写死**（v0.25）：Height 由图片按自己的比例撑出来。
                                     v0.23 走的是另一条路 —— 把盒高固定成 240、再重裁资源去配它
                                     （盒宽 = 默认窗口1180 − 侧栏76 − 左右padding 40 = 1064，
                                     1064/240 = 4.4333 = 资源比例 1920×433）。那条路**只在默认
                                     窗口这一个宽度下成立**：窗口一拉宽（用户全屏 = 1920），
                                     盒宽从 1064 涨到 1804，盒比例 7.52 比资源的 4.43 扁得多，
                                     图片为了填满只能纵向裁掉 41%，人物当场切头
                                     （用户原话：「放大到全屏就走样了」）。
                                     现在改成 Stretch=Uniform：盒宽变大时图片**跟着长高**，
                                     任何窗口尺寸下都是完整一张图、也不留空边。
                                     资源仍由 _icon_work/_mkbanner.py 从源图裁出；
                                     check_wiring 第 14 节改为挡住"写死 Height / 用
                                     UniformToFill"这种回退写法。 -->
                                <Border x:Name="HomeBannerBox" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,16">
                                    <Grid>
                                        <!-- Stretch=Uniform（不是 UniformToFill）：内容永远完整，
                                             比例失配时宁可留边也不裁 —— 而盒高又由本图的比例撑出来，
                                             所以实际上既不留边也不裁 -->
                                        <Image x:Name="HomeBanner" Stretch="Uniform"
                                               Source="Assets/home-banner.jpg"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#D00B1119" Offset="0"/>
                                                    <GradientStop Color="#8C0B1119" Offset="0.40"/>
                                                    <GradientStop Color="#000B1119" Offset="0.75"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0">
                                            <TextBlock Text="Stable Diffusion WebUI" FontSize="12.5" Foreground="#AFC4DC"/>
                                            <TextBlock Text="Forge Neo · 启动器" FontSize="30" FontWeight="Bold"
                                                       Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                            <TextBlock Text="点燃炉火，让想象落笔成画" FontSize="14" Foreground="#C6D6E8"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="文件夹" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TopBtnText}" Margin="2,0,0,10"/>

                                <!-- 快捷入口卡片。数据在 RefreshHome() 里组，类型必须用属性（绑定只反射属性） -->
                                <ItemsControl x:Name="HomeFolderList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource HomeCard}" Tag="{Binding FullPath}"
                                                    ToolTip="{Binding FullPath}" Click="HomeFolder_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="17" VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                    <StackPanel Grid.Column="1" Margin="2,0,10,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TopBtnText}"/>
                                                        <TextBlock Text="{Binding Sub}" FontSize="10.5"
                                                                   Foreground="{DynamicResource StateDetail}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource StateDetail}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 底部：版本/状态信息 + 一键启动（照绘世，启动按钮常驻这一页的右下角） -->
                                <Border x:Name="HomeFootCard" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="HomeVerText" Text="" FontSize="12.5"
                                                       Foreground="{DynamicResource TopBtnText}"/>
                                            <TextBlock x:Name="HomeRootText" Text="" FontSize="11"
                                                       Foreground="{DynamicResource StateDetail}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="16,0,0,0">
                                            <Button x:Name="HomeOpenBtn" Content="打开界面" Style="{StaticResource TopBtn}"
                                                    Height="44" Padding="20,0" Margin="0,0,10,0" IsEnabled="False"
                                                    Click="Open_Click"/>
                                            <Button x:Name="HomeStartBtn" Style="{StaticResource TopBtnPrimary}"
                                                    Height="44" Padding="26,0" Click="HomeStart_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="一键启动" FontSize="15" Margin="9,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ============ 控制台视图：状态 + 进度 + 日志（无论亮暗主题，始终黑色） ============ -->
                    <Border x:Name="MainView" Background="#131519" Visibility="Collapsed" Padding="16,14">
                        <TextBox x:Name="Console" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="#101216" BorderThickness="0" Padding="14,12"
                                 FontFamily="Consolas" FontSize="12.5" Foreground="#AEB8C4"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <!-- ============ 一键部署视图 ============ -->
                    <!-- 启动时体检不通过会自动切到这里：把「缺什么」摆明，再给一个按钮 -->
                    <Border x:Name="DeployView" Background="{DynamicResource WindowBg}" Visibility="Collapsed" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="一键部署" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <Border x:Name="DeployBadge" Background="#E0A030" CornerRadius="4"
                                            Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DeployBadgeText" Text="未部署" FontSize="10.5" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- 环境体检：逐项列出必需文件在不在 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="环境体检" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TopBtnText}"/>
                                            <TextBlock x:Name="DeployCheckHint" Style="{StaticResource AdvHint}"
                                                       Margin="0,2,0,10" TextWrapping="Wrap" Text=""/>
                                            <StackPanel x:Name="DeployCheckList"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 下载源：与「高级选项 → 服务与网络」是同一个档位，改哪边都生效 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="依赖下载源" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TopBtnText}"/>
                                            <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,10" TextWrapping="Wrap"
                                                       Text="首次部署与安装 PyTorch 时从哪儿下载。国内网络建议先用「国内加速」，卡住了再切回官方源。"/>
                                            <ComboBox x:Name="DeploySourceBox"
                                                      Style="{StaticResource ComfyCombo}"
                                                      ItemContainerStyle="{StaticResource ComfyComboItem}"
                                                      SelectionChanged="DeploySource_Changed">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TopBtnText}"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource StateDetail}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- 把档位落成具体域名：镜像站哪天挂了，能一眼看出正用哪个地址 -->
                                            <Border Background="#131519" BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,10,0,0">
                                                <TextBlock x:Name="DeploySourceHint" FontFamily="Consolas" FontSize="11"
                                                           TextWrapping="Wrap" Text="" Foreground="#8FD3F4"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 操作区 -->
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,13">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="DeployBtn" DockPanel.Dock="Left"
                                                        Content="开始部署" Style="{StaticResource TopBtnPrimary}"
                                                        Height="36" Padding="24,0" Click="DeployBtn_Click"/>
                                                <Button x:Name="DeployGoBtn" DockPanel.Dock="Left"
                                                        Content="进入一键启动" Style="{StaticResource TopBtn}"
                                                        Height="36" Padding="18,0" Margin="10,0,0,0"
                                                        Visibility="Collapsed" Click="DeployGoStart_Click"/>
                                                <TextBlock x:Name="DeployStatusText" VerticalAlignment="Center"
                                                           Margin="14,0,0,0" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource StateDetail}" Text=""/>
                                            </DockPanel>

                                            <!-- 进度条：自绘（与顶部那条同一套路数，主题跟随，不用 ProgressBar 默认皮肤）
                                                 建虚拟环境时来回滑动；Forge 装依赖时按日志里 tqdm 的真实百分比填充 -->
                                            <Grid x:Name="DeployBarRow" Margin="0,12,0,0" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="DeployBarBack" Grid.Column="0" Height="6" CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        SizeChanged="BarTrack_SizeChanged"
                                                        Background="{DynamicResource CardBorder}">
                                                    <Grid ClipToBounds="True">
                                                        <Border x:Name="DeployBarFill" Width="0"
                                                                HorizontalAlignment="Left" CornerRadius="3"
                                                                Background="{StaticResource AccentBrush}"/>
                                                        <Border x:Name="DeployBarMarquee" Width="96"
                                                                HorizontalAlignment="Left" CornerRadius="3"
                                                                Background="{StaticResource AccentBrush}" Opacity="0.85"
                                                                Visibility="Collapsed">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="DeployMarqueeShift" X="0"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="DeployBarText" Grid.Column="1" FontSize="11"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource StateDetail}" Text=""/>
                                            </Grid>

                                            <!-- 两步进度清单（代码生成，和上面的体检清单同一排版） -->
                                            <StackPanel x:Name="DeployStepList" Margin="0,12,0,0"/>

                                            <!-- 最近一条动作 / uv 原样输出：静默期也能看出"它在干活" -->
                                            <Border x:Name="DeployLiveBox" Margin="0,10,0,0" Padding="10,7" CornerRadius="7"
                                                    Background="#131519" BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1" Visibility="Collapsed">
                                                <TextBlock x:Name="DeployLiveText" FontFamily="Consolas" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="#8FD3F4" Text=""/>
                                            </Border>

                                            <TextBlock x:Name="DeployNextHint" Style="{StaticResource AdvHint}"
                                                       Margin="0,10,0,0" TextWrapping="Wrap" Text=""/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ============ 版本管理视图 ============ -->
                    <Border x:Name="VersionView" Background="{DynamicResource WindowBg}" Visibility="Collapsed" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="版本管理" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VerLauncherVerText" Text="启动器 v0.37"
                                                   Foreground="{DynamicResource SubtitleText}" FontSize="10.5"/>
                                    </Border>
                                    <TextBlock x:Name="VerStatusText" Text="" FontSize="12" Margin="14,0,0,0"
                                               Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <!-- 这一页只管内核。插件那一套按钮（检测插件更新 / 一键更新全部）
                                         已随插件列表一起搬到【插件管理】页。 -->
                                    <Button x:Name="CheckUpdateBtn" Content="检测内核更新" Style="{StaticResource TopBtn}" Height="32" Margin="6,0" Click="CheckUpdate_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 选项卡：组件更新 / PyTorch 环境 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="VTabUpdate" GroupName="VerTabs" Style="{StaticResource AdvTab}"
                                             Content="组件更新" IsChecked="True" Checked="VerTab_Checked"/>
                                <RadioButton x:Name="VTabTorch" GroupName="VerTabs" Style="{StaticResource AdvTab}"
                                             Content="PyTorch 环境" Checked="VerTab_Checked"/>
                            </StackPanel>

                            <!-- === 面板一：组件更新（只剩内核 —— 插件已拆到【插件管理】页） === -->
                            <Grid x:Name="PaneUpdate" Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 未检测时的引导（首次进入版本管理页会看到它） -->
                                <Border x:Name="VerIdleHint" Grid.Row="0" Grid.RowSpan="2"
                                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="30,26"
                                        VerticalAlignment="Top">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                                   Foreground="{DynamicResource SubtitleText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="尚未检测更新" FontSize="14.5" FontWeight="SemiBold" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource TopBtnText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="点右上角【检测内核更新】检查 Forge Neo 内核是否有新版本；插件的装 / 卸 / 启停 / 更新在【插件管理】页。"
                                                   FontSize="11.5" Margin="0,7,0,0" TextAlignment="Center"
                                                   Foreground="{DynamicResource StateDetail}" HorizontalAlignment="Center"/>
                                        <Button Content="立即检测" Style="{StaticResource TopBtnPrimary}" Height="34"
                                                Margin="0,16,0,0" Padding="26,0" HorizontalAlignment="Center"
                                                Click="CheckUpdate_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 内核信息卡片 -->
                                <Border x:Name="CoreCard" Grid.Row="0" Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,12"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Forge Neo 内核" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TopBtnText}"/>
                                                <Border x:Name="CoreBadge" Background="#E0E0E0" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CoreBadgeText" Text="未检测" FontSize="10.5" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="CoreRemoteText" Text="远程地址：—" FontSize="11.5" Margin="0,7,0,0"
                                                       Foreground="{DynamicResource StateDetail}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock x:Name="CoreCurrentText" Text="当前版本：—" FontSize="11.5"
                                                           Foreground="{DynamicResource StateDetail}"/>
                                                <TextBlock x:Name="CoreLatestText" Text="  最新版本：—" FontSize="11.5"
                                                           Foreground="{DynamicResource StateDetail}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CoreMsgText" Text="" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource StateDetail}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button x:Name="CoreUpdateBtn" Grid.Column="1" Content="更新内核"
                                                Style="{StaticResource TopBtn}" Height="32" Width="92"
                                                VerticalAlignment="Center" IsEnabled="False" Click="CoreUpdate_Click"/>
                                    </Grid>
                                </Border>

                            </Grid>

                            <!-- === 面板二：PyTorch 环境 === -->
                            <Grid x:Name="PaneTorch" Grid.Row="2" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 当前环境 -->
                                <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="当前 PyTorch 环境" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TopBtnText}"/>
                                                <Border x:Name="TorchBadge" Background="#E0E0E0" CornerRadius="4" Padding="7,2"
                                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TorchBadgeText" Text="未检测" FontSize="10.5" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TorchEnvText" Text="正在读取 ..." FontSize="11.5" Margin="0,7,0,0"
                                                       Foreground="{DynamicResource StateDetail}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TorchPyText" Text="" FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource StateDetail}"/>
                                        </StackPanel>
                                        <Button x:Name="TorchRefreshBtn" Grid.Column="1" Content="重新检测"
                                                Style="{StaticResource TopBtn}" Height="32" Width="82"
                                                VerticalAlignment="Center" Click="TorchRefresh_Click"/>
                                    </Grid>
                                </Border>

                                <!-- 支线 + 版本选择（两个下拉框，点一下展开菜单） -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="CUDA 支线" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,7"
                                                   Foreground="{DynamicResource TopBtnText}"/>
                                        <ComboBox x:Name="TorchBranchBox" Margin="0,0,0,14"
                                                  Style="{StaticResource ComfyCombo}"
                                                  ItemContainerStyle="{StaticResource ComfyComboItem}"
                                                  SelectionChanged="TorchBranch_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 展开时：主标题 + 描述两行 -->
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TopBtnText}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource StateDetail}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="PyTorch 版本" FontSize="12.5" FontWeight="SemiBold" Margin="2,0,0,7"
                                                   Foreground="{DynamicResource TopBtnText}"/>
                                        <ComboBox x:Name="TorchBuildBox"
                                                  Style="{StaticResource ComfyCombo}"
                                                  ItemContainerStyle="{StaticResource ComfyComboItem}"
                                                  SelectionChanged="TorchBuild_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 展开时：版本号（带「当前」徽章）+ 配套组件 -->
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TopBtnText}"/>
                                                            <Border x:Name="curBadge" Background="{StaticResource AccentBrush}"
                                                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                                                <TextBlock Text="当前" FontSize="9.5" Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource StateDetail}"/>
                                                    </StackPanel>
                                                    <!-- 用 DataTrigger 代替 Bool→Visibility 转换器，少一个类 -->
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter TargetName="curBadge" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- 选中项的完整说明（ComfyUI Desktop 就在下拉框下方这样显示） -->
                                        <TextBlock x:Name="TorchBuildHint" FontSize="11" Margin="2,8,2,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StateDetail}"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 安装区 -->
                                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="ForceReinstallChk" Content="强制重装（即使已是该版本也重新下载写入）"
                                                  FontSize="11.5" Margin="0,0,0,9"
                                                  Foreground="{DynamicResource StateDetail}"
                                                  Checked="ForceReinstall_Changed" Unchecked="ForceReinstall_Changed"/>

                                        <Border Background="#131519" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,0,9">
                                            <TextBox x:Name="TorchCmdPreview" IsReadOnly="True" TextWrapping="Wrap"
                                                     BorderThickness="0" Background="Transparent"
                                                     FontFamily="Consolas" FontSize="11.5" Foreground="#8FD3F4"
                                                     VerticalScrollBarVisibility="Auto" MaxHeight="62"/>
                                        </Border>

                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button x:Name="TorchInstallBtn" Content="安装所选版本"
                                                        Style="{StaticResource TopBtnPrimary}" Height="34" Padding="20,0"
                                                        Click="TorchInstall_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TorchMsg" FontSize="11" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource StateDetail}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ 插件管理视图（v0.32 从「版本管理」里拆出来） ============ -->
                    <Border x:Name="ExtensionView" Background="{DynamicResource WindowBg}" Visibility="Collapsed" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏。⚠ 这里有**自己的一份**状态文字（ExtStatusText）：
                                 两个页面各干各的活，共用一条状态栏的话，
                                 在插件页点刷新会把内核那页的提示覆盖掉（反之亦然）。 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="插件管理" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExtStatusText" Text="" FontSize="12" Margin="14,0,0,0"
                                               Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <!-- 「一键更新全部」在这一页 = 更新全部**插件**。
                                         内核不在这里 —— 它有自己的卡片和「更新内核」按钮，
                                         混在一起时"全部"到底含不含内核只能靠猜。 -->
                                    <Button x:Name="BtnExtCheck" Content="检测插件更新" Style="{StaticResource TopBtn}"
                                            Height="32" Margin="6,0" Click="ExtCheck_Click"/>
                                    <Button x:Name="UpdateAllBtn" Content="一键更新全部" Style="{StaticResource TopBtnPrimary}"
                                            Height="32" Margin="6,0" Click="UpdateAll_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 插件列表标题 -->
                            <DockPanel x:Name="ExtHeader" Grid.Row="1" Margin="2,0,0,8">
                                <TextBlock Text="扩展 / 插件" FontSize="13.5" FontWeight="SemiBold" DockPanel.Dock="Left"
                                           Foreground="{DynamicResource TopBtnText}"/>
                                <TextBlock x:Name="ExtCountText" Text="" FontSize="11.5" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- 插件工具条：装 / 启停 / 搜索 / 刷新。
                                 ⚠ 内核那一栏不在这一页 —— 两者是两类东西：
                                 内核只有一个、上游写死；插件有 N 个、各有各的 origin。 -->
                            <Grid x:Name="ExtToolRow" Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="从地址安装" Style="{StaticResource AdvLabel}"
                                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <TextBox x:Name="ExtInstallBox" Grid.Column="1" Style="{StaticResource AdvInput}"
                                         Height="30" VerticalContentAlignment="Center"
                                         ToolTip="粘贴 GitHub 仓库地址后点「安装」，例如 https://github.com/Haoming02/sd-webui-forge-couple"/>
                                <Button x:Name="BtnExtInstall" Grid.Column="2" Content="安装" Style="{StaticResource TopBtn}"
                                        Height="30" Padding="16,0" Margin="8,0,0,0" Click="ExtInstall_Click"/>

                                <TextBlock Grid.Column="3" Text="搜索" Style="{StaticResource AdvLabel}"
                                           VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <TextBox x:Name="ExtSearchBox" Grid.Column="4" Style="{StaticResource AdvInput}"
                                         Height="30" VerticalContentAlignment="Center"
                                         TextChanged="ExtSearch_TextChanged"
                                         ToolTip="按名称 / 来源 / 状态过滤，输入即筛"/>
                                <Button x:Name="BtnExtRefresh" Grid.Column="5" Content="刷新列表" Style="{StaticResource TopBtn}"
                                        Height="30" Padding="16,0" Margin="8,0,0,0" Click="ExtRefresh_Click"/>
                            </Grid>

                            <!-- 插件列表 -->
                            <Border x:Name="ExtCard" Grid.Row="3" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="0">
                                <ListView x:Name="ExtList" Background="Transparent" BorderThickness="0"
                                          ItemContainerStyle="{StaticResource VerListItem}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource VerHeader}">
                                            <GridViewColumn Header="启用" Width="52">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- ⚠ 用 Click 而不是 Checked/Unchecked：
                                                             后两者在「填充列表」时就会被触发，
                                                             于是每次刷新都会真的去改一遍配置。 -->
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                  Click="ExtToggle_Click"
                                                                  Tag="{Binding}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="勾选 = 启用（清掉 disabled 标记并移出 config.json 的禁用名单）"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="名称" Width="185" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="来源" Width="200" DisplayMemberBinding="{Binding SourceText}"/>
                                            <GridViewColumn Header="当前" Width="80" DisplayMemberBinding="{Binding CurrentVersion}"/>
                                            <GridViewColumn Header="最新" Width="80" DisplayMemberBinding="{Binding LatestVersion}"/>
                                            <GridViewColumn Header="状态" Width="115" DisplayMemberBinding="{Binding Message}"/>
                                            <GridViewColumn Header="操作" Width="150">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="更新" Height="26" Width="66" Margin="0,2,4,2"
                                                                    Style="{StaticResource TopBtn}"
                                                                    Click="ExtUpdate_Click"
                                                                    IsEnabled="{Binding CanUpdate}"
                                                                    Tag="{Binding}"/>
                                                            <Button Content="卸载" Height="26" Width="66" Margin="0,2,0,2"
                                                                    Style="{StaticResource TopBtn}"
                                                                    Click="ExtUninstall_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============ 模型管理视图 ============ -->
                    <!-- 这一页是**只读**的：装 / 挪 / 删模型是资源管理器的事，这里负责“看得见”。
                         卡片清单**派生自磁盘**（ModelCatalog.Scan）—— 注解表只负责给人话说明，
                         上游新增目录、或用户自己建的目录，都会自动出现在列表里。 -->
                    <Border x:Name="ModelView" Background="{DynamicResource WindowBg}" Visibility="Collapsed" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏。状态文字是这一页**自己的**一份（ModelStatusText）——
                                 与内核页 / 插件页各一份：共用一条会把对方的提示覆盖掉。 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="模型管理" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModelStatusText" Text="" FontSize="12" Margin="14,0,0,0"
                                               Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnModelRefresh" Content="重新扫描" Style="{StaticResource TopBtn}"
                                            Height="32" Padding="14,0" Margin="6,0" Click="ModelRefresh_Click"/>
                                    <Button x:Name="BtnModelOpen" Content="打开 models 目录" Style="{StaticResource TopBtn}"
                                            Height="32" Padding="14,0" Margin="6,0" Click="ModelOpenRoot_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 工具条。左边搜索（输入即筛）；右边指路去高级选项追加目录 ——
                                 追加目录要改启动参数（ckpt-dirs 这类），那是那一页的事。 -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="搜索" Style="{StaticResource AdvLabel}"
                                           VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <TextBox x:Name="ModelSearchBox" Grid.Column="1" Style="{StaticResource AdvInput}"
                                         Height="30" VerticalContentAlignment="Center"
                                         TextChanged="ModelSearch_TextChanged"
                                         ToolTip="按目录名或文件名过滤，输入即筛（例如 flux / sdxl / 某个 lora 名）"/>
                                <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,2,0"
                                           Foreground="{DynamicResource StateDetail}"
                                           Text="要追加其他位置的模型目录：高级选项 → 模型目录"/>
                            </Grid>

                            <!-- 卡片区：每个模型目录一张卡，卡里直接列出它有什么 -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ModelList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- 头行：分类名 · 用途 …… 体积 · 打开 -->
                                                    <DockPanel>
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="0,0,10,0"
                                                                       Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                                            <!-- ⚠ Tag 传的是**路径字符串**，不是整张卡片 ——
                                                                 打开目录只需要路径，别让事件处理去依赖绑定对象。 -->
                                                            <Button Content="打开" Height="26" Width="62" Style="{StaticResource TopBtn}"
                                                                    Click="ModelOpen_Click" Tag="{Binding Dir}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Desc}" FontSize="11.5" Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- 路径（长了省略，ToolTip 给全）+ 条目计数 -->
                                                    <DockPanel Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding CountText}" DockPanel.Dock="Right" FontSize="11"
                                                                   Margin="10,0,0,0" Foreground="{DynamicResource StateDetail}"/>
                                                        <TextBlock Text="{Binding Dir}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Dir}" Foreground="{DynamicResource StateDetail}"/>
                                                    </DockPanel>

                                                    <!-- 空状态 / 读取失败：三种情况各自明说（目录不存在 / 目录是空的 / 读取失败） -->
                                                    <TextBlock Text="{Binding NoteText}" FontSize="11.5" Margin="0,6,0,0"
                                                               TextWrapping="Wrap" Foreground="{DynamicResource StateDetail}"/>

                                                    <!-- 本层条目：文件名（左）、文件夹的“多少项”（中）、体积（右） -->
                                                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,7,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,1.5">
                                                                    <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Width="86"
                                                                               TextAlignment="Right" FontSize="11.5"
                                                                               Foreground="{DynamicResource StateDetail}"/>
                                                                    <TextBlock Text="{Binding NoteText}" DockPanel.Dock="Right" Width="58"
                                                                               TextAlignment="Right" FontSize="11"
                                                                               Foreground="{DynamicResource StateDetail}"/>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                               Foreground="{DynamicResource TopBtnText}"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 截断说明（没截断时是空串，TextBlock 空文本不占高度） -->
                                                    <TextBlock Text="{Binding MoreText}" FontSize="11" Margin="0,5,0,0"
                                                               Foreground="{DynamicResource StateDetail}"/>

                                                    <!-- 附属文件隐藏说明（v0.36；没隐藏时是空串）。
                                                         ⚠ 这一行**不能省**：卡片头的 CountText 写的是磁盘真相
                                                         （比如「7 个文件」），而下面只列 3 行 —— 不解释一句
                                                         就会被当成 bug。这正是"不许静默"那条。 -->
                                                    <TextBlock Text="{Binding HiddenText}" FontSize="11" Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource StateDetail}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ============ 高级选项视图 ============ -->
                    <Border x:Name="AdvancedView" Background="{DynamicResource WindowBg}"
                            Visibility="Collapsed" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="高级选项" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TopBtnText}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="启动参数" Foreground="{DynamicResource SubtitleText}" FontSize="10.5"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Content="恢复默认" Style="{StaticResource TopBtn}" Height="32" Margin="6,0"
                                            Click="AdvReset_Click"/>
                                    <Button Content="保存并应用" Style="{StaticResource TopBtnPrimary}" Height="32" Margin="6,0"
                                            Click="AdvSave_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- ============ 选项卡 ============ -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="TabPerf" GroupName="AdvTabs" Style="{StaticResource AdvTab}"
                                             Content="性能" IsChecked="True" Checked="AdvTab_Checked"/>
                                <RadioButton x:Name="TabService" GroupName="AdvTabs" Style="{StaticResource AdvTab}"
                                             Content="服务与网络" Checked="AdvTab_Checked"/>
                                <RadioButton x:Name="TabModel" GroupName="AdvTabs" Style="{StaticResource AdvTab}"
                                             Content="模型目录" Checked="AdvTab_Checked"/>
                            </StackPanel>

                            <!-- ============ 选项卡内容 ============ -->
                            <Grid Grid.Row="2">

                                <!-- === 性能 === -->
                                <ScrollViewer x:Name="PanePerf" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="模型加载" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="影响启动时与切换模型时的等待时间。" Style="{StaticResource AdvHint}" Margin="0,2,0,10"/>

                                                <DockPanel Margin="0,0,0,10">
                                                    <ToggleButton x:Name="SwNoHashing" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="禁用模型哈希校验" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --no-hashing。跳过对 ckpt 逐个算 sha256，模型多的目录下启动明显更快。推荐开启。"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel>
                                                    <ToggleButton x:Name="SwAutotune" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="cudnn 自动调优" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --autotune。让 cuDNN 试跑多套卷积算法后选最快的，长期收益为正；代价是换模型或换分辨率后的首次生成会变慢。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="内存与显存" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="模型在显存装不下时会暂存到内存，这一组改善两边之间的搬运效率。" Style="{StaticResource AdvHint}" Margin="0,2,0,10"/>

                                                <DockPanel Margin="0,0,0,10">
                                                    <ToggleButton x:Name="SwPinShared" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="锁页内存" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --pin-shared-memory。用锁页内存做中转，提升内存↔显存传输速度。内存 ≥ 32GB 时收益更明显。"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel>
                                                    <ToggleButton x:Name="SwExpandSeg" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="可扩展显存段" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --expandable-segments。缓解显存碎片，但属实验性选项，遇到生成异常可先关掉它。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 显存预留 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="显存预留" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,7" TextWrapping="Wrap"
                                                           Text="对应 --reserve-vram。主动让出一部分显存给同时运行的其他程序（游戏、剪辑、另一个 WebUI），避免两边互相抢到爆显存。留空 = 不启用。"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ReserveVramBox" Grid.Column="0" Style="{StaticResource AdvInput}"
                                                             TextChanged="AdvReserveVram_TextChanged"/>
                                                    <TextBlock Grid.Column="1" Text="GB（例如 0.5 或 1）" Style="{StaticResource AdvHint}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 注意力后端 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13">
                                            <StackPanel>
                                                <TextBlock Text="注意力后端（排障用）" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,10" TextWrapping="Wrap"
                                                           Text="正常情况下由 Forge 自动挑选，这三个都该关着。只有在「注意力后端加载失败」或生成结果异常需要逐个排除时，才勾掉对应的那个。"/>

                                                <DockPanel Margin="0,0,0,10">
                                                    <ToggleButton x:Name="SwDisableSage" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="关闭 sageattention" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Text="对应 --disable-sage" Style="{StaticResource AdvHint}" Margin="0,2,12,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel Margin="0,0,0,10">
                                                    <ToggleButton x:Name="SwDisableFlash" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="关闭 flash_attn" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Text="对应 --disable-flash" Style="{StaticResource AdvHint}" Margin="0,2,12,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel>
                                                    <ToggleButton x:Name="SwDisableXformers" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="关闭 xformers" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Text="对应 --disable-xformers" Style="{StaticResource AdvHint}" Margin="0,2,12,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- === 服务与网络 === -->
                                <ScrollViewer x:Name="PaneService" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="扩展与依赖" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="决定启动时要不要顺带维护第三方扩展的依赖。" Style="{StaticResource AdvHint}" Margin="0,2,0,10"/>
                                                <DockPanel>
                                                    <ToggleButton x:Name="SwInstallExtDeps" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="启动时检查并补装扩展依赖" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0" TextWrapping="Wrap"
                                                                   Text="控制是否发送 --skip-install。⚠ 默认关闭：多数扩展的依赖声明只写裸包名（不带版本），pip 会按「装最新」解析，可能把 Forge 钉死的包顶掉 —— 实测 wd14-tagger 的 tensorflow 会把 protobuf 顶到 7.x，导致 Forge 彻底起不来。只有新装了扩展、且它确实缺包时才打开，装完请关回去。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="启动行为" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="控制服务自身的启动方式。" Style="{StaticResource AdvHint}" Margin="0,2,0,10"/>
                                                <DockPanel>
                                                    <ToggleButton x:Name="SwAutoOpen" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="就绪后自动打开界面" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="服务起来后由启动器打开系统默认浏览器。关闭则两边都不打开（WebUI 自身那份同时被抑制），需要时点【打开界面】。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 服务端口 —— 它决定"服务到底在哪"，
                                             于是也决定了自动换端口 / 打开界面 / 停止服务指向哪一个实例。 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="服务端口" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,7" TextWrapping="Wrap"
                                                           Text="对应 --port。启动器会把端口显式传给 Forge，因此它就是服务真正所在的端口，而不是「希望它在的端口」。"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PortBox" Grid.Column="0" Style="{StaticResource AdvInput}"
                                                             TextChanged="AdvPort_TextChanged"/>
                                                    <TextBlock Grid.Column="1" Text="1 ~ 65535，默认 7860" Style="{StaticResource AdvHint}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>

                                                <DockPanel Margin="0,12,0,0">
                                                    <ToggleButton x:Name="SwAutoSwitchPort" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="端口被占用时自动改用其他端口" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0" TextWrapping="Wrap"
                                                                   Text="只对「被其他程序占用」生效：会从该端口往后找一个空闲的。若端口上坐的是本包的 Forge，则视为服务已在运行、进入监控模式接管，不再另开实例。关闭后遇到占用会直接报错，且绝不会去结束那个进程。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="接口服务" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="供第三方客户端、脚本或插件调用。" Style="{StaticResource AdvHint}" Margin="0,2,0,10"/>
                                                <DockPanel>
                                                    <ToggleButton x:Name="SwApi" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="开启 API 接口" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --api。开启后可通过 /sdapi/v1 等接口调用；不使用外部客户端时无需开启。"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 依赖下载源：薄包首装要从网上拉 4~5 GB，这是国内能不能装上的关键开关 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="依赖下载源" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,12" TextWrapping="Wrap"
                                                           Text="首次部署与安装 PyTorch 时从哪儿下载。只改子进程的下载地址，不动 Forge 的任何文件。"/>

                                                <ComboBox x:Name="SourceBox"
                                                          Style="{StaticResource ComfyCombo}"
                                                          ItemContainerStyle="{StaticResource ComfyComboItem}"
                                                          SelectionChanged="AdvSource_Changed">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TopBtnText}"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource StateDetail}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- 把「国内加速 / 官方源」落成具体域名，镜像站哪天挂了能一眼看出在用哪个 -->
                                                <Border Background="#131519" BorderBrush="{DynamicResource CardBorder}"
                                                        BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,10,0,0">
                                                    <TextBlock x:Name="SourceHint" FontFamily="Consolas" FontSize="11"
                                                               TextWrapping="Wrap" Text=""
                                                               Foreground="#8FD3F4"/>
                                                </Border>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Text="镜像站偶尔会抽风。若安装卡住或报下载失败，切回「官方源」再试一次即可。"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 网络暴露：安全敏感，单独用警示色卡片 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="#E2A03F"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="#E2A03F" VerticalAlignment="Center"/>
                                                    <TextBlock Text="局域网访问" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,4,0,12" TextWrapping="Wrap"
                                                           Text="默认仅本机可访问。勾选后同一网络下的任何设备都能打开你的界面，务必同时设置访问密码。"/>

                                                <DockPanel Margin="0,0,0,10">
                                                    <ToggleButton x:Name="SwListen" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="对局域网开放" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0"
                                                                   Text="对应 --listen。不勾选时服务只监听本机回环地址。"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <TextBlock Text="访问认证（用户名:密码）" Style="{StaticResource AdvLabel}"
                                                           Margin="0,0,0,5"/>
                                                <TextBox x:Name="AuthBox" Style="{StaticResource AdvInput}"
                                                         TextChanged="AdvAuth_TextChanged"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Text="对应 --gradio-auth。可写多组，用英文逗号分隔，如 user:1234,admin:5678；只写用户名时默认补 :1234。"/>
                                                <TextBlock x:Name="AuthWarn" Foreground="#E2A03F" FontSize="11" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" Visibility="Collapsed"
                                                           Text="⚠ 已开启局域网访问但未设置密码，服务将无保护地暴露给同网络的所有设备。"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- === 模型目录 === -->
                                <ScrollViewer x:Name="PaneModel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- 复用已有 A1111 安装：默认关闭。
                                             整合包不能假定别人机器上有 A1111，指向不存在的目录会让 Forge 启动即报错 -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <DockPanel>
                                                    <ToggleButton x:Name="SwA1111Home" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                                  VerticalAlignment="Center" Checked="AdvOption_Toggled" Unchecked="AdvOption_Toggled"/>
                                                    <StackPanel>
                                                        <TextBlock Text="复用已有 A1111 模型目录" Style="{StaticResource AdvLabel}"/>
                                                        <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,12,0" TextWrapping="Wrap"
                                                                   Text="对应 --forge-ref-a1111-home。仅当你这台机器上确实装了 A1111 / 秋叶包时才开启。"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <StackPanel x:Name="A1111Panel" Visibility="Collapsed" Margin="0,12,0,0">
                                                    <TextBlock Text="A1111 安装根目录" Style="{StaticResource AdvLabel}" Margin="0,0,0,5"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="A1111Box" Grid.Column="0" Style="{StaticResource AdvInput}"
                                                                 TextChanged="AdvA1111_TextChanged"/>
                                                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource TopBtn}"
                                                                Height="28" Width="58" Margin="8,0,0,0"
                                                                Click="AdvA1111Browse_Click"/>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource AdvHint}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                               Text="指向 A1111 安装的根目录（其下应有 models 子目录），而不是 models 目录本身。"/>
                                                    <TextBlock Foreground="#E2A03F" FontSize="11" Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               Text="⚠ 这是本机专属设置：把包拷到没有 A1111 的电脑上会启动失败，届时关掉此开关即可。"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="额外模型目录" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,12" TextWrapping="Wrap"
                                                           Text="用于追加目录，多个目录里的模型都会出现在 WebUI 的模型下拉列表里。不填也能用——模型直接放进包内的 models 目录即可。"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Checkpoint -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Checkpoint 大模型" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="对应 --ckpt-dirs" Style="{StaticResource AdvHint}" Margin="0,2,0,7"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource WindowBg}"
                                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7">
                                                        <ListBox x:Name="CkptList" Background="Transparent" BorderThickness="0"
                                                                 Height="84" Padding="3"
                                                                 ItemContainerStyle="{StaticResource AdvListItem}"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <Button Content="添加目录" Style="{StaticResource TopBtn}" Height="26" Width="72"
                                                                Tag="ckpt" Click="AdvDirAdd_Click"/>
                                                        <Button Content="移除选中" Style="{StaticResource TopBtn}" Height="26" Width="72" Margin="0,6,0,0"
                                                                Tag="ckpt" Click="AdvDirRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- LoRA -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="LoRA" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="对应 --lora-dirs" Style="{StaticResource AdvHint}" Margin="0,2,0,7"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource WindowBg}"
                                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7">
                                                        <ListBox x:Name="LoraList" Background="Transparent" BorderThickness="0"
                                                                 Height="84" Padding="3"
                                                                 ItemContainerStyle="{StaticResource AdvListItem}"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <Button Content="添加目录" Style="{StaticResource TopBtn}" Height="26" Width="72"
                                                                Tag="lora" Click="AdvDirAdd_Click"/>
                                                        <Button Content="移除选中" Style="{StaticResource TopBtn}" Height="26" Width="72" Margin="0,6,0,0"
                                                                Tag="lora" Click="AdvDirRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- VAE -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="VAE" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="对应 --vae-dirs" Style="{StaticResource AdvHint}" Margin="0,2,0,7"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource WindowBg}"
                                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7">
                                                        <ListBox x:Name="VaeList" Background="Transparent" BorderThickness="0"
                                                                 Height="84" Padding="3"
                                                                 ItemContainerStyle="{StaticResource AdvListItem}"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <Button Content="添加目录" Style="{StaticResource TopBtn}" Height="26" Width="72"
                                                                Tag="vae" Click="AdvDirAdd_Click"/>
                                                        <Button Content="移除选中" Style="{StaticResource TopBtn}" Height="26" Width="72" Margin="0,6,0,0"
                                                                Tag="vae" Click="AdvDirRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Text Encoder -->
                                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1" CornerRadius="10" Padding="16,13">
                                            <StackPanel>
                                                <TextBlock Text="Text Encoder 文本编码器" Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource AdvHint}" Margin="0,2,0,7" TextWrapping="Wrap"
                                                           Text="对应 --text-encoder-dirs。Flux / Qwen 这类模型把文本编码器单独存放，目录不写在这里，WebUI 会「模型在、却报找不到文本编码器」。"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource WindowBg}"
                                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7">
                                                        <ListBox x:Name="TextEncList" Background="Transparent" BorderThickness="0"
                                                                 Height="84" Padding="3"
                                                                 ItemContainerStyle="{StaticResource AdvListItem}"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <Button Content="添加目录" Style="{StaticResource TopBtn}" Height="26" Width="72"
                                                                Tag="textenc" Click="AdvDirAdd_Click"/>
                                                        <Button Content="移除选中" Style="{StaticResource TopBtn}" Height="26" Width="72" Margin="0,6,0,0"
                                                                Tag="textenc" Click="AdvDirRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ============ 实时预览 ============ -->
                            <Border Grid.Row="3" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,12,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock Text="即将使用的启动参数" DockPanel.Dock="Left"
                                                   Style="{StaticResource AdvLabel}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ArgCountText" DockPanel.Dock="Right" FontSize="11"
                                                   Foreground="{DynamicResource StateDetail}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Background="#131519" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="7" Padding="10,8">
                                        <TextBox x:Name="ArgPreview" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" FontFamily="Consolas" FontSize="11.5"
                                                 Foreground="#8FD3F4" VerticalScrollBarVisibility="Auto" MaxHeight="74"/>
                                    </Border>
                                    <TextBlock x:Name="AdvMsg" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource StateDetail}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        </Border>
      </DockPanel>
    </Border>
</Window>
